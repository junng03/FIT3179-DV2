{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dumbbell chart: share of each adult age group who watched user-generated or short-form online video (e.g. YouTube, TikTok, Instagram) in the past 7 days, 2024 (grey) vs 2025 (orange). A switch orders the age groups by age or by the size of the drop. Source: ACMA, How we watch and listen to content (2026), data tables QF4.",
  "width": "container",
  "height": 300,
  "params": [
    {
      "name": "order_by",
      "value": "Age",
      "bind": {
        "input": "radio",
        "options": [
          "Age",
          "Biggest drop"
        ],
        "name": "Order by: "
      }
    }
  ],
  "data": {
    "url": "data/acma_ugc_by_age.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "pct": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "toString(datum.year)",
      "as": "year_label"
    },
    {
      "calculate": "datum.year === 2024 ? datum.pct : null",
      "as": "p2024"
    },
    {
      "calculate": "datum.year === 2025 ? datum.pct : null",
      "as": "p2025"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "p2024",
          "as": "pct_2024"
        },
        {
          "op": "max",
          "field": "p2025",
          "as": "pct_2025"
        }
      ],
      "groupby": [
        "age_group"
      ]
    },
    {
      "calculate": "datum.pct_2025 - datum.pct_2024",
      "as": "change"
    },
    {
      "calculate": "indexof(['18-24', '25-34', '35-44', '45-54', '55-64', '65-74', '75+'], datum.age_group)",
      "as": "age_index"
    },
    {
      "calculate": "order_by === 'Age' ? datum.age_index : datum.change",
      "as": "sort_key"
    },
    {
      "window": [
        {
          "op": "dense_rank",
          "as": "position"
        }
      ],
      "sort": [
        {
          "field": "sort_key",
          "order": "ascending"
        },
        {
          "field": "age_group",
          "order": "ascending"
        }
      ]
    },
    {
      "calculate": "(datum.position < 10 ? '0' : '') + datum.position + '|' + datum.age_group",
      "as": "y_key"
    }
  ],
  "encoding": {
    "y": {
      "field": "y_key",
      "type": "ordinal",
      "title": null,
      "sort": "ascending",
      "axis": {
        "domain": false,
        "ticks": false,
        "labelPadding": 8,
        "labelExpr": "split(datum.value, '|')[1]"
      }
    },
    "x": {
      "field": "pct",
      "type": "quantitative",
      "title": "Adults who watched in the past 7 days (%)",
      "scale": {
        "domain": [
          0,
          100
        ]
      },
      "axis": {
        "tickCount": 5
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#c3c2b7",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "aggregate": "min",
          "field": "pct",
          "type": "quantitative"
        },
        "x2": {
          "aggregate": "max",
          "field": "pct"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 170,
        "opacity": 1,
        "stroke": "#fcfcfb",
        "strokeWidth": 1.5
      },
      "encoding": {
        "color": {
          "field": "year_label",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "2024",
              "2025"
            ],
            "range": [
              "#aeada5",
              "#eb6834"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {
            "field": "age_group",
            "title": "Age group"
          },
          {
            "field": "year_label",
            "title": "Year"
          },
          {
            "field": "pct",
            "title": "Watched in past 7 days (%)",
            "format": ".0f"
          },
          {
            "field": "change",
            "title": "Change 2024 to 2025 (points)",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2025"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -12,
        "color": "#a8431b",
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "pct",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2024"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 12,
        "color": "#898781"
      },
      "encoding": {
        "text": {
          "field": "pct",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    }
  ]
}