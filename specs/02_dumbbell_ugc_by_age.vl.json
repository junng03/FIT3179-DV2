{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Vertical dumbbell chart: share of each adult age group who watched user-generated or short-form online video (e.g. YouTube, TikTok, Instagram) in the 7 days before the survey, 2024 (grey) vs 2025 (red). Age groups run left to right, so each line reads as a drop from 2024 down to 2025. Source: ACMA, How we watch and listen to content (2026), data tables QF4.",
  "width": "container",
  "height": 360,
  "data": {
    "url": "data/acma_ugc_by_age.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "pct": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "toString(datum.year)",
      "as": "year_label"
    },
    {
      "calculate": "datum.year === 2024 ? datum.pct : null",
      "as": "p2024"
    },
    {
      "calculate": "datum.year === 2025 ? datum.pct : null",
      "as": "p2025"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "p2024",
          "as": "pct_2024"
        },
        {
          "op": "max",
          "field": "p2025",
          "as": "pct_2025"
        }
      ],
      "groupby": [
        "age_group"
      ]
    },
    {
      "calculate": "datum.pct_2025 - datum.pct_2024",
      "as": "change"
    },
    {
      "calculate": "indexof(['18-24', '25-34', '35-44', '45-54', '55-64', '65-74', '75+'], datum.age_group)",
      "as": "age_index"
    },
    {
      "calculate": "datum.age_index",
      "as": "sort_key"
    },
    {
      "window": [
        {
          "op": "dense_rank",
          "as": "position"
        }
      ],
      "sort": [
        {
          "field": "sort_key",
          "order": "ascending"
        },
        {
          "field": "age_group",
          "order": "ascending"
        }
      ]
    },
    {
      "calculate": "(datum.position < 10 ? '0' : '') + datum.position + '|' + datum.age_group",
      "as": "y_key"
    }
  ],
  "encoding": {
    "x": {
      "field": "y_key",
      "type": "ordinal",
      "title": null,
      "sort": "ascending",
      "axis": {
        "domain": false,
        "ticks": false,
        "labelPadding": 8,
        "labelAngle": 0,
        "labelExpr": "split(datum.value, '|')[1]"
      }
    },
    "y": {
      "field": "pct",
      "type": "quantitative",
      "title": "Adults who watched in the 7 days before the survey (%)",
      "scale": {
        "domain": [
          0,
          100
        ]
      },
      "axis": {
        "tickCount": 5
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#cccccc",
        "strokeWidth": 4
      },
      "encoding": {
        "y": {
          "aggregate": "min",
          "field": "pct",
          "type": "quantitative"
        },
        "y2": {
          "aggregate": "max",
          "field": "pct"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 170,
        "opacity": 1,
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "color": {
          "field": "year_label",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "2024",
              "2025"
            ],
            "range": [
              "#b3b3b3",
              "#ff0033"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {
            "field": "age_group",
            "title": "Age group"
          },
          {
            "field": "year_label",
            "title": "Year"
          },
          {
            "field": "pct",
            "title": "Watched in the 7 days before the survey (%)",
            "format": ".0f"
          },
          {
            "field": "change",
            "title": "Change 2024 to 2025 (points)",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2025"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "top",
        "dy": 12,
        "color": "#cc0000",
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "pct",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2024"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "dy": -12,
        "color": "#909090"
      },
      "encoding": {
        "text": {
          "field": "pct",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    },
    {
      "description": "The change, in percentage points, beside each line (one label per age group).",
      "transform": [
        {
          "filter": "datum.year === 2025"
        },
        {
          "calculate": "(datum.pct_2024 + datum.pct_2025) / 2",
          "as": "mid"
        },
        {
          "calculate": "datum.change === 0 ? 'no change' : format(datum.change, '+.1f') + ' pts'",
          "as": "change_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 12,
        "color": "#606060"
      },
      "encoding": {
        "y": {
          "field": "mid",
          "type": "quantitative"
        },
        "text": {
          "field": "change_label"
        }
      }
    }
  ]
}