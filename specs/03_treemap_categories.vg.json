{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Zoomable treemap of Australia's top 40 YouTube creators. Each rectangle is one channel, grouped by its main category (the YouTube category used most often across its 50 most recent uploads) and sized by subscribers or total views. Gaming, the largest category, is orange. Click a category to zoom in; click again to zoom out. Source: YouTube Data API v3.",
  "height": 460,
  "padding": 4,
  "autosize": "none",
  "signals": [
    {
      "name": "width",
      "init": "isFinite(containerSize()[0]) && containerSize()[0] > 0 ? containerSize()[0] - 8 : 760",
      "on": [
        {
          "events": "window:resize",
          "update": "isFinite(containerSize()[0]) && containerSize()[0] > 0 ? containerSize()[0] - 8 : 760"
        }
      ]
    },
    {
      "name": "size_by",
      "value": "subscribers",
      "bind": {
        "input": "radio",
        "options": ["subscribers", "views"],
        "labels": ["Subscribers", "Total views"],
        "name": "Size by: "
      }
    },
    {
      "name": "zoom",
      "description": "The category being zoomed into, or '' for all categories.",
      "value": "",
      "on": [
        {
          "events": "@cells:click, @groupbox:click, @grouplabel:click",
          "update": "zoom !== '' ? '' : (datum.category ? datum.category : datum.key)"
        },
        {"events": "@header:click", "update": "''"}
      ]
    },
    {
      "name": "header_h",
      "value": 26
    }
  ],
  "data": [
    {
      "name": "creators",
      "url": "data/creators.csv",
      "format": {
        "type": "csv",
        "parse": {
          "subscribers": "number",
          "views": "number",
          "videos": "number",
          "made_for_kids_share": "number",
          "shorts_share": "number"
        }
      }
    },
    {
      "name": "shown",
      "source": "creators",
      "transform": [
        {"type": "formula", "expr": "datum[size_by]", "as": "size"},
        {"type": "filter", "expr": "zoom === '' || datum.category === zoom"}
      ]
    },
    {
      "name": "tree",
      "source": "shown",
      "transform": [
        {"type": "nest", "keys": ["category"], "generate": true},
        {
          "type": "treemap",
          "field": "size",
          "sort": {"field": "value", "order": "descending"},
          "round": true,
          "method": "squarify",
          "ratio": 1.4,
          "paddingInner": 2,
          "paddingTop": 20,
          "size": [{"signal": "width"}, {"signal": "height - header_h + 20"}]
        },
        {"type": "formula", "expr": "datum.y0 + header_h - 20", "as": "y0"},
        {"type": "formula", "expr": "datum.y1 + header_h - 20", "as": "y1"}
      ]
    },
    {
      "name": "groups",
      "source": "tree",
      "transform": [
        {"type": "filter", "expr": "datum.children && datum.depth === 1"},
        {"type": "formula", "expr": "datum.children", "as": "n"}
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {"type": "filter", "expr": "!datum.children"},
        {"type": "formula", "expr": "replace(format(datum.size, '.3~s'), 'G', 'B')", "as": "size_label"}
      ]
    }
  ],
  "marks": [
    {
      "type": "text",
      "name": "header",
      "encode": {
        "enter": {
          "x": {"value": 0},
          "y": {"value": 14},
          "fontSize": {"value": 12},
          "baseline": {"value": "middle"}
        },
        "update": {
          "text": {
            "signal": "zoom !== '' ? '← Back to all categories   ·   showing ' + zoom + ' only' : 'Click any category to zoom in'"
          },
          "fill": {"signal": "zoom !== '' ? '#a8431b' : '#52514e'"},
          "fontWeight": {"signal": "zoom !== '' ? 'bold' : 'normal'"},
          "cursor": {"signal": "zoom !== '' ? 'pointer' : 'default'"}
        }
      }
    },
    {
      "type": "rect",
      "name": "groupbox",
      "from": {"data": "groups"},
      "encode": {
        "update": {
          "x": {"field": "x0"},
          "y": {"field": "y0"},
          "x2": {"field": "x1"},
          "y2": {"field": "y1"},
          "fill": {"value": "#f0efec"},
          "cursor": {"value": "pointer"},
          "tooltip": {
            "signal": "{'Category': datum.key, 'Channels': datum.n, 'Combined': format(datum.value, ',') + (size_by === 'views' ? ' views' : ' subscribers'), 'Click': zoom !== '' ? 'to zoom out' : 'to zoom in'}"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "grouplabel",
      "from": {"data": "groups"},
      "encode": {
        "update": {
          "x": {"signal": "datum.x0 + 4"},
          "y": {"signal": "datum.y0 + 14"},
          "text": {
            "signal": "(datum.x1 - datum.x0) > 70 ? datum.key + ((datum.x1 - datum.x0) > 150 ? ' · ' + datum.n + (datum.n === 1 ? ' channel' : ' channels') : '') : ''"
          },
          "limit": {"signal": "datum.x1 - datum.x0 - 8"},
          "fontSize": {"value": 12},
          "fontWeight": {"value": "bold"},
          "fill": {"value": "#0b0b0b"},
          "cursor": {"value": "pointer"}
        }
      }
    },
    {
      "type": "rect",
      "name": "cells",
      "from": {"data": "leaves"},
      "encode": {
        "update": {
          "x": {"field": "x0"},
          "y": {"field": "y0"},
          "x2": {"field": "x1"},
          "y2": {"field": "y1"},
          "fill": {"signal": "datum.category === 'Gaming' ? '#eb6834' : '#2a78d6'"},
          "stroke": {"value": "#fcfcfb"},
          "strokeWidth": {"value": 1},
          "cursor": {"value": "pointer"},
          "tooltip": {
            "signal": "{'Channel': datum.channel, 'Main category': datum.category, 'Subscribers': format(datum.subscribers, ','), 'Total views': format(datum.views, ','), 'Videos uploaded': format(datum.videos, ','), 'Recent uploads that are Shorts (3 min or less)': format(datum.shorts_share, '.0%'), 'Click': zoom !== '' ? 'to zoom out' : 'to zoom in to ' + datum.category}"
          }
        },
        "hover": {
          "stroke": {"value": "#0b0b0b"},
          "strokeWidth": {"value": 2}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "leaves"},
      "interactive": false,
      "encode": {
        "update": {
          "x": {"signal": "datum.x0 + 5"},
          "y": {"signal": "datum.y0 + 15"},
          "text": {
            "signal": "(datum.x1 - datum.x0) > 60 && (datum.y1 - datum.y0) > 22 ? datum.channel : ''"
          },
          "limit": {"signal": "datum.x1 - datum.x0 - 10"},
          "fontSize": {"value": 12},
          "fontWeight": {"value": "bold"},
          "fill": {"value": "#ffffff"}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "leaves"},
      "interactive": false,
      "encode": {
        "update": {
          "x": {"signal": "datum.x0 + 5"},
          "y": {"signal": "datum.y0 + 30"},
          "text": {
            "signal": "(datum.x1 - datum.x0) > 60 && (datum.y1 - datum.y0) > 40 ? datum.size_label + (size_by === 'views' ? ' views' : ' subs') : ''"
          },
          "limit": {"signal": "datum.x1 - datum.x0 - 10"},
          "fontSize": {"value": 12},
          "fill": {"value": "#ffffff"}
        }
      }
    }
  ]
}
