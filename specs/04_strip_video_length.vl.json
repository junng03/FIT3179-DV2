{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Jittered strip plot of the 50 most recent uploads from Australia's top 40 YouTube creators, grouped by YouTube category. A switch shows each video's views (the default), length or likes (all on log scales), and the categories are always ordered by median views (fewest to most). Orange = 3 minutes or shorter (likely Shorts); grey = longer. Black tick = median of the measure shown. clicking the legend shows only Shorts or only longer videos. Lengths retrieved 10 October 2026, views and likes 17 October 2026. Source: YouTube Data API v3. Hovering anywhere highlights the nearest video and shows its details in a line above the chart.",
  "width": "container",
  "height": 380,
  "data": {
    "url": "data/videos.csv",
    "format": {
      "type": "csv",
      "parse": {
        "duration_s": "number",
        "views": "number",
        "likes": "number"
      }
    }
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "count",
          "as": "cat_n"
        }
      ],
      "groupby": [
        "category"
      ]
    },
    {
      "filter": "datum.cat_n >= 20"
    },
    {
      "calculate": "datum.duration_s / 60",
      "as": "minutes"
    },
    {
      "calculate": "show_metric === 'Length' ? datum.minutes : show_metric === 'Views' ? datum.views : datum.likes",
      "as": "value"
    },
    {
      "calculate": "datum.views",
      "as": "sort_value"
    },
    {
      "joinaggregate": [
        {
          "op": "median",
          "field": "sort_value",
          "as": "cat_sort"
        }
      ],
      "groupby": [
        "category"
      ]
    },
    {
      "window": [
        {
          "op": "dense_rank",
          "as": "cat_position"
        }
      ],
      "sort": [
        {
          "field": "cat_sort",
          "order": "ascending"
        },
        {
          "field": "category",
          "order": "ascending"
        }
      ]
    },
    {
      "calculate": "(datum.cat_position < 10 ? '0' : '') + datum.cat_position + '|' + datum.category",
      "as": "x_key"
    },
    {
      "calculate": "datum.is_short === 'True' ? 'Short (3 minutes or less)' : 'Longer video'",
      "as": "format"
    },
    {
      "calculate": "random()",
      "as": "jitter"
    },
    {
      "calculate": "datum.duration_s < 60 ? datum.duration_s + ' s' : datum.duration_s < 3600 ? format(datum.duration_s / 60, '.0f') + ' min' : floor(datum.duration_s / 3600) + ' h ' + format((datum.duration_s % 3600) / 60, '.0f') + ' min'",
      "as": "length_label"
    },
    {
      "calculate": "datum.channel + '  ·  ' + datum.category + '  ·  ' + datum.length_label + '  ·  ' + format(datum.views, ',') + ' views  ·  ' + format(datum.likes, ',') + ' likes  ·  published ' + datum.published",
      "as": "info"
    }
  ],
  "encoding": {
    "x": {
      "field": "x_key",
      "type": "nominal",
      "title": null,
      "sort": "ascending",
      "axis": {
        "labelAngle": -30,
        "labelLimit": 140,
        "domain": false,
        "ticks": false,
        "labelExpr": "split(datum.value, '|')[1]"
      }
    }
  },
  "layer": [
    {
      "params": [
        {
          "name": "pick_format",
          "select": {
            "type": "point",
            "fields": [
              "format"
            ]
          },
          "bind": "legend"
        },
        {
          "name": "hover_vid",
          "select": {
            "type": "point",
            "fields": [
              "video_id"
            ],
            "on": "pointerover",
            "nearest": true,
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "circle",
        "cursor": "crosshair"
      },
      "encoding": {
        "xOffset": {
          "field": "jitter",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.6,
              1.6
            ]
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "scale": {
            "type": "log",
            "domain": {
              "expr": "show_metric === 'Length' ? [0.05, 720] : show_metric === 'Views' ? [1000, 300000000] : [10, 10000000]"
            }
          },
          "axis": {
            "title": {
              "expr": "show_metric === 'Length' ? 'Video length' : show_metric === 'Views' ? 'Views per video' : 'Likes per video'"
            },
            "values": {
              "expr": "show_metric === 'Length' ? [0.0833, 0.25, 1, 3, 10, 30, 60, 180, 600] : show_metric === 'Views' ? [1000, 10000, 100000, 1000000, 10000000, 100000000] : [10, 100, 1000, 10000, 100000, 1000000, 10000000]"
            },
            "labelExpr": "show_metric === 'Length' ? (datum.value < 1 ? round(datum.value * 60) + ' s' : datum.value >= 60 ? (datum.value / 60) + ' h' : datum.value + ' min') : replace(format(datum.value, '~s'), 'G', 'B')",
            "minExtent": 40
          }
        },
        "color": {
          "field": "format",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Short (3 minutes or less)",
              "Longer video"
            ],
            "range": [
              "#eb6834",
              "#aeada5"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "symbolOpacity": 1
          }
        },
        "size": {
          "condition": {
            "param": "hover_vid",
            "empty": false,
            "value": 170
          },
          "value": 18
        },
        "opacity": {
          "condition": [
            {
              "param": "hover_vid",
              "empty": false,
              "value": 1
            },
            {
              "param": "pick_format",
              "value": 0.6
            }
          ],
          "value": 0.08
        },
        "stroke": {
          "condition": {
            "param": "hover_vid",
            "empty": false,
            "value": "#0b0b0b"
          },
          "value": null
        },
        "strokeWidth": {
          "condition": {
            "param": "hover_vid",
            "empty": false,
            "value": 2
          },
          "value": 0.6
        }
      }
    },
    {
      "mark": {
        "type": "tick",
        "color": "#0b0b0b",
        "thickness": 3,
        "size": 34
      },
      "encoding": {
        "y": {
          "aggregate": "median",
          "field": "value",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "category",
            "title": "Category"
          },
          {
            "aggregate": "median",
            "field": "minutes",
            "title": "Median length (minutes)",
            "format": ".1f"
          },
          {
            "aggregate": "median",
            "field": "views",
            "title": "Median views",
            "format": ",.0f"
          },
          {
            "aggregate": "median",
            "field": "likes",
            "title": "Median likes",
            "format": ",.0f"
          },
          {
            "aggregate": "count",
            "title": "Videos"
          }
        ]
      }
    },
    {
      "description": "Details of the hovered video, in a fixed line above the chart (no need to land exactly on a dot).",
      "transform": [
        {
          "filter": {
            "param": "hover_vid",
            "empty": false
          }
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "dy": -14,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#0b0b0b"
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width"
          }
        },
        "y": {
          "value": 0
        },
        "text": {
          "field": "info"
        }
      }
    },
    {
      "description": "Prompt shown while no video is hovered.",
      "data": {
        "values": [
          {}
        ]
      },
      "transform": [
        {
          "filter": "!length(data('hover_vid_store'))"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "dy": -14,
        "fontSize": 12,
        "color": "#898781",
        "fontStyle": "italic"
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width"
          }
        },
        "y": {
          "value": 0
        },
        "text": {
          "value": "Hover the chart: the nearest video's details appear here"
        }
      }
    },
    {
      "description": "Annotation: the middle (median) value for Shorts vs longer videos, for whichever measure is shown. Calculated from the data.",
      "transform": [
        {
          "aggregate": [
            {
              "op": "median",
              "field": "value",
              "as": "med"
            }
          ],
          "groupby": [
            "format"
          ]
        },
        {
          "pivot": "format",
          "value": "med"
        },
        {
          "calculate": "show_metric === 'Length' ? 'Median length: Shorts ' + (datum['Short (3 minutes or less)'] < 1 ? round(datum['Short (3 minutes or less)'] * 60) + ' s' : format(datum['Short (3 minutes or less)'], '.1f') + ' min') + '  ·  longer videos ' + (datum['Longer video'] < 1 ? round(datum['Longer video'] * 60) + ' s' : format(datum['Longer video'], '.1f') + ' min') : 'Median ' + (show_metric === 'Views' ? 'views' : 'likes') + ' per video: longer videos ' + format(round(datum['Longer video'] / 1000) * 1000, ',') + '  ·  Shorts ' + format(round(datum['Short (3 minutes or less)'] / 1000) * 1000, ',')",
          "as": "note"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontWeight": "bold",
        "color": "#0b0b0b"
      },
      "encoding": {
        "x": {
          "value": 6
        },
        "y": {
          "value": 4
        },
        "text": {
          "field": "note"
        }
      }
    }
  ],
  "params": [
    {
      "name": "show_metric",
      "value": "Views",
      "bind": {
        "input": "radio",
        "options": [
          "Length",
          "Views",
          "Likes"
        ],
        "name": "Show: "
      }
    }
  ]
}