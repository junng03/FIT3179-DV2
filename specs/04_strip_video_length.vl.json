{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Jittered strip plot of the 50 most recent uploads from Australia's top 40 YouTube creators, grouped by YouTube category. A switch shows each video's length, views or likes (all on log scales), and a second switch sorts the categories by median length, views or likes. Orange = 3 minutes or shorter (likely Shorts); grey = longer. Black tick = median of the measure shown. A menu highlights one creator's videos; clicking the legend shows only Shorts or only longer videos. Lengths retrieved 10 October 2026, views and likes 17 October 2026. Source: YouTube Data API v3.",
  "width": "container",
  "height": 380,
  "data": {
    "url": "data/videos.csv",
    "format": {
      "type": "csv",
      "parse": {
        "duration_s": "number",
        "views": "number",
        "likes": "number"
      }
    }
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "count",
          "as": "cat_n"
        }
      ],
      "groupby": [
        "category"
      ]
    },
    {
      "filter": "datum.cat_n >= 20"
    },
    {
      "calculate": "datum.duration_s / 60",
      "as": "minutes"
    },
    {
      "calculate": "show_metric === 'Length' ? datum.minutes : show_metric === 'Views' ? datum.views : datum.likes",
      "as": "value"
    },
    {
      "calculate": "sort_metric === 'Length' ? datum.minutes : sort_metric === 'Views' ? datum.views : datum.likes",
      "as": "sort_value"
    },
    {
      "joinaggregate": [
        {
          "op": "median",
          "field": "sort_value",
          "as": "cat_sort"
        }
      ],
      "groupby": [
        "category"
      ]
    },
    {
      "window": [
        {
          "op": "dense_rank",
          "as": "cat_position"
        }
      ],
      "sort": [
        {
          "field": "cat_sort",
          "order": "ascending"
        },
        {
          "field": "category",
          "order": "ascending"
        }
      ]
    },
    {
      "calculate": "(datum.cat_position < 10 ? '0' : '') + datum.cat_position + '|' + datum.category",
      "as": "x_key"
    },
    {
      "calculate": "datum.is_short === 'True' ? 'Short (3 minutes or less)' : 'Longer video'",
      "as": "format"
    },
    {
      "calculate": "random()",
      "as": "jitter"
    }
  ],
  "encoding": {
    "x": {
      "field": "x_key",
      "type": "nominal",
      "title": null,
      "sort": "ascending",
      "axis": {
        "labelAngle": -30,
        "labelLimit": 140,
        "domain": false,
        "ticks": false,
        "labelExpr": "split(datum.value, '|')[1]"
      }
    }
  },
  "layer": [
    {
      "params": [
        {
          "name": "pick_creator",
          "select": {
            "type": "point",
            "fields": [
              "channel"
            ]
          },
          "bind": {
            "input": "select",
            "options": [
              null,
              "Ash on LoL",
              "Aunty Donna",
              "Avi Yemini",
              "Bridey Drake",
              "Code Bullet",
              "DankPods",
              "DarkViperAU",
              "Eddie Woo",
              "Fairbairn Films",
              "Felix Colgrave",
              "Fresh",
              "friendlyjordies",
              "GmanLives",
              "How Ridiculous",
              "How To Cook That",
              "HowToBasic",
              "I did a thing",
              "Isaac Butterfield",
              "Karl Jobst",
              "Lachlan",
              "LazarBeam",
              "Leah Halton",
              "Lewis Spears",
              "Loserfruit",
              "Luke Kidgell",
              "martincitopants",
              "maxmoefoegames",
              "Muselk",
              "Neel Kolhatkar",
              "Norris Nuts Do Stuff",
              "PearlescentMoon",
              "Phoenix SC",
              "Pretty Pastel Please",
              "Primitive Technology",
              "Sailing La Vagabonde",
              "superwog1",
              "thejuicemedia",
              "Tibees",
              "TwoSetViolin",
              "悉尼奶爸  Sydney DaDDy 雪梨奶爸"
            ],
            "labels": [
              "All creators",
              "Ash on LoL",
              "Aunty Donna",
              "Avi Yemini",
              "Bridey Drake",
              "Code Bullet",
              "DankPods",
              "DarkViperAU",
              "Eddie Woo",
              "Fairbairn Films",
              "Felix Colgrave",
              "Fresh",
              "friendlyjordies",
              "GmanLives",
              "How Ridiculous",
              "How To Cook That",
              "HowToBasic",
              "I did a thing",
              "Isaac Butterfield",
              "Karl Jobst",
              "Lachlan",
              "LazarBeam",
              "Leah Halton",
              "Lewis Spears",
              "Loserfruit",
              "Luke Kidgell",
              "martincitopants",
              "maxmoefoegames",
              "Muselk",
              "Neel Kolhatkar",
              "Norris Nuts Do Stuff",
              "PearlescentMoon",
              "Phoenix SC",
              "Pretty Pastel Please",
              "Primitive Technology",
              "Sailing La Vagabonde",
              "superwog1",
              "thejuicemedia",
              "Tibees",
              "TwoSetViolin",
              "悉尼奶爸  Sydney DaDDy 雪梨奶爸"
            ],
            "name": "Highlight a creator: "
          }
        },
        {
          "name": "pick_format",
          "select": {
            "type": "point",
            "fields": [
              "format"
            ]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "circle"
      },
      "encoding": {
        "xOffset": {
          "field": "jitter",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.6,
              1.6
            ]
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "scale": {
            "type": "log",
            "domain": {
              "expr": "show_metric === 'Length' ? [0.05, 720] : show_metric === 'Views' ? [1000, 300000000] : [10, 10000000]"
            }
          },
          "axis": {
            "title": {
              "expr": "show_metric === 'Length' ? 'Video length (log scale)' : show_metric === 'Views' ? 'Views (log scale)' : 'Likes (log scale)'"
            },
            "values": {
              "expr": "show_metric === 'Length' ? [0.0833, 0.25, 1, 3, 10, 30, 60, 180, 600] : show_metric === 'Views' ? [1000, 10000, 100000, 1000000, 10000000, 100000000] : [10, 100, 1000, 10000, 100000, 1000000, 10000000]"
            },
            "labelExpr": "show_metric === 'Length' ? (datum.value < 1 ? round(datum.value * 60) + ' s' : datum.value >= 60 ? (datum.value / 60) + ' h' : datum.value + ' min') : replace(format(datum.value, '~s'), 'G', 'B')",
            "minExtent": 40
          }
        },
        "color": {
          "field": "format",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Short (3 minutes or less)",
              "Longer video"
            ],
            "range": [
              "#eb6834",
              "#aeada5"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "symbolOpacity": 1
          }
        },
        "size": {
          "condition": {
            "param": "pick_creator",
            "empty": false,
            "value": 60
          },
          "value": 18
        },
        "opacity": {
          "condition": {
            "test": {
              "and": [
                {
                  "param": "pick_creator"
                },
                {
                  "param": "pick_format"
                }
              ]
            },
            "value": 0.6
          },
          "value": 0.08
        },
        "stroke": {
          "condition": {
            "param": "pick_creator",
            "empty": false,
            "value": "#0b0b0b"
          },
          "value": null
        },
        "strokeWidth": {
          "value": 0.6
        },
        "tooltip": [
          {
            "field": "channel",
            "title": "Channel"
          },
          {
            "field": "category",
            "title": "Category"
          },
          {
            "field": "minutes",
            "title": "Length (minutes)",
            "format": ".1f"
          },
          {
            "field": "views",
            "title": "Views",
            "format": ","
          },
          {
            "field": "likes",
            "title": "Likes",
            "format": ","
          },
          {
            "field": "published",
            "title": "Published"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "tick",
        "color": "#0b0b0b",
        "thickness": 3,
        "size": 34
      },
      "encoding": {
        "y": {
          "aggregate": "median",
          "field": "value",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "category",
            "title": "Category"
          },
          {
            "aggregate": "median",
            "field": "minutes",
            "title": "Median length (minutes)",
            "format": ".1f"
          },
          {
            "aggregate": "median",
            "field": "views",
            "title": "Median views",
            "format": ",.0f"
          },
          {
            "aggregate": "median",
            "field": "likes",
            "title": "Median likes",
            "format": ",.0f"
          },
          {
            "aggregate": "count",
            "title": "Videos"
          }
        ]
      }
    }
  ],
  "params": [
    {
      "name": "show_metric",
      "value": "Length",
      "bind": {
        "input": "radio",
        "options": [
          "Length",
          "Views",
          "Likes"
        ],
        "name": "Show: "
      }
    },
    {
      "name": "sort_metric",
      "value": "Length",
      "bind": {
        "input": "radio",
        "options": [
          "Length",
          "Views",
          "Likes"
        ],
        "labels": [
          "Median length",
          "Median views",
          "Median likes"
        ],
        "name": "Sort categories by: "
      }
    }
  ]
}