{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map of where Australia's top 40 YouTube creators are based (one circle per documented home city, area = combined subscribers, views or videos of the creators based there), linked to a bar chart of the 15 largest channels by the same measure. Click a city or a bar to highlight that city in both views; double-click to clear. Sources: YouTube Data API v3; Wikipedia/Wikidata and news sources for home cities; ABS-derived state boundaries.",
  "data": {
    "url": "data/creators.csv",
    "format": {
      "type": "csv",
      "parse": {
        "subscribers": "number",
        "views": "number",
        "videos": "number",
        "lat": "number",
        "lon": "number"
      }
    }
  },
  "params": [
    {
      "name": "metric",
      "value": "subscribers",
      "bind": {
        "input": "radio",
        "options": [
          "subscribers",
          "views",
          "videos"
        ],
        "labels": [
          "Subscribers",
          "Total views",
          "Videos uploaded"
        ],
        "name": "Measure: "
      }
    },
    {
      "name": "pick",
      "select": {
        "type": "point",
        "fields": [
          "city"
        ],
        "on": "click",
        "clear": "dblclick"
      },
      "views": [
        "creator_dots",
        "creator_bars"
      ]
    }
  ],
  "transform": [
    {
      "calculate": "datum[metric]",
      "as": "m"
    }
  ],
  "spacing": 40,
  "hconcat": [
    {
      "width": 500,
      "height": 430,
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -18,
          -36
        ],
        "rotate": [
          -133,
          0
        ],
        "center": [
          0,
          -27
        ]
      },
      "layer": [
        {
          "data": {
            "url": "https://cdn.jsdelivr.net/gh/rowanhogan/australian-states@master/states.geojson",
            "format": {
              "type": "json",
              "property": "features"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#f0efec",
            "stroke": "#c3c2b7",
            "strokeWidth": 0.8
          }
        },
        {
          "name": "creator_dots",
          "transform": [
            {
              "filter": "isValid(datum.lat) && isValid(datum.lon)"
            },
            {
              "aggregate": [
                {
                  "op": "sum",
                  "field": "m",
                  "as": "total_m"
                },
                {
                  "op": "sum",
                  "field": "subscribers",
                  "as": "total_subs"
                },
                {
                  "op": "sum",
                  "field": "views",
                  "as": "total_views"
                },
                {
                  "op": "count",
                  "as": "n"
                },
                {
                  "op": "values",
                  "as": "vals"
                }
              ],
              "groupby": [
                "city",
                "lat",
                "lon"
              ]
            },
            {
              "calculate": "join(pluck(datum.vals, 'channel'), ', ')",
              "as": "names"
            }
          ],
          "mark": {
            "type": "circle",
            "stroke": "#fcfcfb",
            "strokeWidth": 1.5,
            "cursor": "pointer"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "size": {
              "field": "total_m",
              "type": "quantitative",
              "title": "City total, for the measure chosen above",
              "scale": {
                "range": [
                  60,
                  2200
                ]
              },
              "legend": {
                "format": "~s",
                "orient": "bottom",
                "direction": "horizontal",
                "symbolFillColor": "#2a78d6",
                "symbolOpacity": 0.6,
                "symbolStrokeWidth": 0,
                "labelExpr": "replace(datum.label, 'G', 'B')",
                "titleLimit": 260,
                "values": {
                  "expr": "metric === 'views' ? [1e9, 5e9, 15e9] : metric === 'videos' ? [500, 2000, 4000] : [2e6, 10e6, 20e6]"
                }
              }
            },
            "color": {
              "condition": {
                "param": "pick",
                "empty": false,
                "value": "#eb6834"
              },
              "value": "#2a78d6"
            },
            "opacity": {
              "value": 0.8
            },
            "order": {
              "field": "total_m",
              "sort": "descending"
            },
            "tooltip": [
              {
                "field": "city",
                "title": "Based in"
              },
              {
                "field": "n",
                "title": "Creators"
              },
              {
                "field": "names",
                "title": "Channels"
              },
              {
                "field": "total_subs",
                "title": "Combined subscribers",
                "format": ","
              },
              {
                "field": "total_views",
                "title": "Combined views",
                "format": ","
              }
            ]
          }
        }
      ]
    },
    {
      "name": "creator_bars",
      "width": 300,
      "height": 430,
      "transform": [
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "m",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.rank <= 15"
        }
      ],
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 4,
        "cursor": "pointer"
      },
      "encoding": {
        "y": {
          "field": "channel",
          "type": "nominal",
          "sort": "-x",
          "title": null,
          "axis": {
            "ticks": false,
            "domain": false
          }
        },
        "x": {
          "field": "m",
          "type": "quantitative",
          "axis": {
            "title": {
              "expr": "metric === 'views' ? 'Total views' : metric === 'videos' ? 'Videos uploaded' : 'YouTube subscribers'"
            },
            "format": "~s",
            "labelExpr": "datum.value === 0 ? '0' : replace(datum.label, 'G', 'B')",
            "tickCount": 4
          }
        },
        "color": {
          "condition": [
            {
              "param": "pick",
              "empty": false,
              "value": "#eb6834"
            },
            {
              "test": "!isValid(datum.lat)",
              "value": "#aeada5"
            }
          ],
          "value": "#2a78d6"
        },
        "tooltip": [
          {
            "field": "channel",
            "title": "Channel"
          },
          {
            "field": "category",
            "title": "Main category"
          },
          {
            "field": "city",
            "title": "Based in"
          },
          {
            "field": "subscribers",
            "title": "Subscribers",
            "format": ","
          },
          {
            "field": "views",
            "title": "Total views",
            "format": ","
          },
          {
            "field": "videos",
            "title": "Videos uploaded",
            "format": ","
          }
        ]
      }
    }
  ]
}