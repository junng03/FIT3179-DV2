{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map of where Australia's top 40 YouTube creators are based (one circle per documented home city, area = combined subscribers of the creators based there), linked to a bar chart of the 15 largest channels by subscribers. Click a city or a bar to highlight that city in both views; double-click to clear. Sources: YouTube Data API v3; Wikipedia/Wikidata and news sources for home cities; ABS-derived state boundaries.",
  "data": {
    "url": "data/creators.csv",
    "format": {
      "type": "csv",
      "parse": {
        "subscribers": "number",
        "views": "number",
        "videos": "number",
        "lat": "number",
        "lon": "number"
      }
    }
  },
  "params": [
    {
      "name": "pick",
      "select": {
        "type": "point",
        "fields": [
          "city"
        ],
        "on": "click",
        "clear": "dblclick"
      },
      "views": [
        "creator_dots",
        "creator_bars"
      ]
    }
  ],
  "transform": [
    {
      "calculate": "datum.subscribers",
      "as": "m"
    }
  ],
  "spacing": 24,
  "hconcat": [
    {
      "width": 460,
      "height": 430,
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -18,
          -36
        ],
        "rotate": [
          -133,
          0
        ],
        "center": [
          0,
          -27
        ]
      },
      "layer": [
        {
          "data": {
            "url": "https://cdn.jsdelivr.net/gh/rowanhogan/australian-states@master/states.geojson",
            "format": {
              "type": "json",
              "property": "features"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#f0efec",
            "stroke": "#c3c2b7",
            "strokeWidth": 0.8
          }
        },
        {
          "name": "creator_dots",
          "transform": [
            {
              "filter": "isValid(datum.lat) && isValid(datum.lon)"
            },
            {
              "aggregate": [
                {
                  "op": "sum",
                  "field": "m",
                  "as": "total_m"
                },
                {
                  "op": "sum",
                  "field": "subscribers",
                  "as": "total_subs"
                },
                {
                  "op": "sum",
                  "field": "views",
                  "as": "total_views"
                },
                {
                  "op": "count",
                  "as": "n"
                },
                {
                  "op": "values",
                  "as": "vals"
                }
              ],
              "groupby": [
                "city",
                "lat",
                "lon"
              ]
            },
            {
              "calculate": "join(pluck(datum.vals, 'channel'), ', ')",
              "as": "names"
            }
          ],
          "mark": {
            "type": "circle",
            "stroke": "#fcfcfb",
            "strokeWidth": 1.5,
            "cursor": "pointer"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "size": {
              "field": "total_m",
              "type": "quantitative",
              "title": "Combined subscribers in each city",
              "scale": {
                "range": [
                  60,
                  2200
                ]
              },
              "legend": {
                "format": "~s",
                "orient": "bottom",
                "direction": "horizontal",
                "symbolFillColor": "#2a78d6",
                "symbolOpacity": 0.6,
                "symbolStrokeWidth": 0,
                "labelExpr": "replace(datum.label, 'G', 'B')",
                "titleLimit": 260,
                "values": [
                  2000000,
                  10000000,
                  20000000
                ]
              }
            },
            "color": {
              "condition": {
                "param": "pick",
                "empty": false,
                "value": "#eb6834"
              },
              "value": "#2a78d6"
            },
            "opacity": {
              "value": 0.8
            },
            "order": {
              "field": "total_m",
              "sort": "descending"
            },
            "tooltip": [
              {
                "field": "city",
                "title": "Based in"
              },
              {
                "field": "n",
                "title": "Creators"
              },
              {
                "field": "names",
                "title": "Channels"
              },
              {
                "field": "total_subs",
                "title": "Combined subscribers",
                "format": ","
              },
              {
                "field": "total_views",
                "title": "Combined views",
                "format": ","
              }
            ]
          }
        },
        {
          "description": "City names beside the circles, placed just past each circle's edge (radius worked out from the circle's area).",
          "transform": [
            {
              "filter": "isValid(datum.lat) && isValid(datum.lon)"
            },
            {
              "aggregate": [
                {
                  "op": "sum",
                  "field": "m",
                  "as": "total_m"
                },
                {
                  "op": "sum",
                  "field": "subscribers",
                  "as": "total_subs"
                },
                {
                  "op": "sum",
                  "field": "views",
                  "as": "total_views"
                },
                {
                  "op": "count",
                  "as": "n"
                },
                {
                  "op": "values",
                  "as": "vals"
                }
              ],
              "groupby": [
                "city",
                "lat",
                "lon"
              ]
            },
            {
              "calculate": "join(pluck(datum.vals, 'channel'), ', ')",
              "as": "names"
            },
            {
              "joinaggregate": [
                {
                  "op": "max",
                  "field": "total_m",
                  "as": "max_m"
                }
              ]
            },
            {
              "calculate": "sqrt((60 + (2200 - 60) * datum.total_m / datum.max_m) / PI)",
              "as": "radius"
            },
            {
              "calculate": "replace(datum.city, ' (shown at Cairns)', '')",
              "as": "city_label"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "fontSize": 12,
            "color": "#0b0b0b",
            "dx": {
              "expr": "datum.radius + 4"
            },
            "dy": {
              "expr": "datum.city === 'Central Coast' ? -10 : datum.city === 'Sydney' ? 10 : 0"
            }
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "city_label"
            }
          }
        }
      ]
    },
    {
      "name": "creator_bars",
      "width": 280,
      "height": 430,
      "transform": [
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "m",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.rank <= 15"
        }
      ],
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 4,
        "cursor": "pointer"
      },
      "encoding": {
        "y": {
          "field": "channel",
          "type": "nominal",
          "sort": "-x",
          "title": null,
          "axis": {
            "ticks": false,
            "domain": false
          }
        },
        "x": {
          "field": "m",
          "type": "quantitative",
          "axis": {
            "title": "YouTube subscribers",
            "format": "~s",
            "labelExpr": "datum.value === 0 ? '0' : replace(datum.label, 'G', 'B')",
            "tickCount": 4
          }
        },
        "color": {
          "condition": [
            {
              "param": "pick",
              "empty": false,
              "value": "#eb6834"
            },
            {
              "test": "!isValid(datum.lat)",
              "value": "#aeada5"
            }
          ],
          "value": "#2a78d6"
        },
        "tooltip": [
          {
            "field": "channel",
            "title": "Channel"
          },
          {
            "field": "category",
            "title": "Main category"
          },
          {
            "field": "city",
            "title": "Based in"
          },
          {
            "field": "subscribers",
            "title": "Subscribers",
            "format": ","
          },
          {
            "field": "views",
            "title": "Total views",
            "format": ","
          },
          {
            "field": "videos",
            "title": "Videos uploaded",
            "format": ","
          }
        ]
      },
      "title": {
        "text": [
          "Blue: shown on the map  ·  grey: home city not documented",
          "Orange: the city you picked"
        ],
        "anchor": "start",
        "fontSize": 12,
        "fontWeight": "normal",
        "color": "#52514e",
        "offset": 10,
        "lineHeight": 16
      }
    }
  ]
}