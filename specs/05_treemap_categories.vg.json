{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Treemap of Australia's top 40 YouTube creators. Each rectangle is one channel, sized by subscribers and grouped by its main category (the YouTube category used most often across its 50 most recent uploads). Source: YouTube Data API v3.",
  "width": 760,
  "height": 440,
  "padding": 4,
  "autosize": "none",
  "data": [
    {
      "name": "creators",
      "url": "data/creators.csv",
      "format": {
        "type": "csv",
        "parse": {
          "subscribers": "number",
          "made_for_kids_share": "number",
          "shorts_share": "number"
        }
      }
    },
    {
      "name": "tree",
      "source": "creators",
      "transform": [
        {
          "type": "nest",
          "keys": [
            "category"
          ],
          "generate": true
        },
        {
          "type": "treemap",
          "field": "subscribers",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "round": true,
          "method": "squarify",
          "ratio": 1.4,
          "paddingInner": 2,
          "paddingTop": 20,
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height + 20"
            }
          ]
        },
        {
          "type": "formula",
          "expr": "datum.y0 - 20",
          "as": "y0"
        },
        {
          "type": "formula",
          "expr": "datum.y1 - 20",
          "as": "y1"
        }
      ]
    },
    {
      "name": "groups",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.children && datum.depth === 1"
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "!datum.children"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "ordinal",
      "domain": {
        "data": "groups",
        "field": "key",
        "sort": {
          "field": "value",
          "op": "max",
          "order": "descending"
        }
      },
      "range": [
        "#2a78d6",
        "#1baf7a",
        "#6250d6",
        "#008300",
        "#e34948",
        "#eda100",
        "#e87ba4",
        "#898781",
        "#898781",
        "#898781",
        "#898781",
        "#898781",
        "#898781",
        "#898781",
        "#898781"
      ]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "groups"
      },
      "encode": {
        "enter": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "value": "#f0efec"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "groups"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "datum.x0 + 4"
          },
          "y": {
            "signal": "datum.y0 + 14"
          },
          "text": {
            "signal": "(datum.x1 - datum.x0) > 70 ? datum.key : ''"
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 8"
          },
          "font": {
            "value": "Atkinson Hyperlegible, system-ui, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#0b0b0b"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "cells",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "enter": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "scale": "color",
            "field": "category"
          },
          "stroke": {
            "value": "#fcfcfb"
          },
          "strokeWidth": {
            "value": 1
          },
          "tooltip": {
            "signal": "{'Channel': datum.channel, 'Main category': datum.category, 'Subscribers': format(datum.subscribers, ','), 'Recent uploads that are Shorts (3 min or less)': format(datum.shorts_share, '.0%'), 'Recent uploads marked made for kids': format(datum.made_for_kids_share, '.0%')}"
          }
        },
        "update": {
          "fillOpacity": {
            "value": 0.85
          }
        },
        "hover": {
          "fillOpacity": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "interactive": false,
      "encode": {
        "enter": {
          "x": {
            "signal": "datum.x0 + 5"
          },
          "y": {
            "signal": "datum.y0 + 15"
          },
          "text": {
            "signal": "(datum.x1 - datum.x0) > 60 && (datum.y1 - datum.y0) > 22 ? datum.channel : ''"
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 10"
          },
          "font": {
            "value": "Atkinson Hyperlegible, system-ui, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#ffffff"
          }
        }
      }
    }
  ]
}
