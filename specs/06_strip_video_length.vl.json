{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Jittered strip plot: length of each of the 50 most recent uploads from Australia's top 40 YouTube creators, grouped by the YouTube category the creator chose. Orange = 3 minutes or shorter (likely Shorts); grey = longer. Black tick = median length. Log scale. Source: YouTube Data API v3.",
  "width": "container",
  "height": 380,
  "data": {
    "url": "data/videos.csv",
    "format": {
      "type": "csv",
      "parse": {
        "duration_s": "number"
      }
    }
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "count",
          "as": "cat_n"
        }
      ],
      "groupby": [
        "category"
      ]
    },
    {
      "filter": "datum.cat_n >= 20"
    },
    {
      "calculate": "datum.duration_s / 60",
      "as": "minutes"
    },
    {
      "calculate": "datum.is_short === 'True' ? 'Short (3 minutes or less)' : 'Longer video'",
      "as": "format"
    },
    {
      "calculate": "random()",
      "as": "jitter"
    }
  ],
  "encoding": {
    "x": {
      "field": "category",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "minutes",
        "op": "median",
        "order": "ascending"
      },
      "axis": {
        "labelAngle": -30,
        "labelLimit": 140,
        "domain": false,
        "ticks": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "circle",
        "size": 18,
        "opacity": 0.55
      },
      "encoding": {
        "xOffset": {
          "field": "jitter",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.6,
              1.6
            ]
          }
        },
        "y": {
          "field": "minutes",
          "type": "quantitative",
          "title": "Video length (minutes, log scale)",
          "scale": {
            "type": "log",
            "domain": [
              0.05,
              720
            ]
          },
          "axis": {
            "values": [
              0.0833,
              0.25,
              1,
              3,
              10,
              30,
              60,
              180,
              600
            ],
            "labelExpr": "datum.value < 1 ? round(datum.value * 60) + ' s' : datum.value >= 60 ? (datum.value / 60) + ' h' : datum.value + ' min'",
            "gridColor": "#e1e0d9"
          }
        },
        "color": {
          "field": "format",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Short (3 minutes or less)",
              "Longer video"
            ],
            "range": [
              "#eb6834",
              "#a9a89f"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {
            "field": "channel",
            "title": "Channel"
          },
          {
            "field": "category",
            "title": "Category"
          },
          {
            "field": "minutes",
            "title": "Length (minutes)",
            "format": ".1f"
          },
          {
            "field": "published",
            "title": "Published"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "tick",
        "color": "#0b0b0b",
        "thickness": 3,
        "size": 34
      },
      "encoding": {
        "y": {
          "aggregate": "median",
          "field": "minutes",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "category",
            "title": "Category"
          },
          {
            "aggregate": "median",
            "field": "minutes",
            "title": "Median length (minutes)",
            "format": ".1f"
          },
          {
            "aggregate": "count",
            "title": "Videos"
          }
        ]
      }
    }
  ]
}
