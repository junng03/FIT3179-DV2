{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Tile grid map as small multiples: the share of each state's YouTube searches that went to in four Australian creators by state and territory over the past 12 months. One equal-sized square per state, so the ACT is as visible as WA. 100 = the state where that creator's share of searches was highest. Hovering a state outlines it in black in all four maps. Source: Google Trends (YouTube Search), retrieved by the author with scripts/fetch_trends.py. Grey tiles: too little search volume for Google to score.",
  "data": {
    "url": "data/trends_state.csv",
    "format": {
      "type": "csv",
      "parse": {
        "interest": "number"
      }
    }
  },
  "transform": [
    {
      "lookup": "state",
      "from": {
        "data": {
          "url": "data/state_tiles.csv",
          "format": {
            "type": "csv",
            "parse": {
              "col": "number",
              "row": "number"
            }
          }
        },
        "key": "state",
        "fields": [
          "abbr",
          "col",
          "row"
        ]
      }
    },
    {
      "calculate": "toNumber(datum.col)",
      "as": "tile_x"
    },
    {
      "calculate": "toNumber(datum.row)",
      "as": "tile_y"
    },
    {
      "calculate": "isValid(datum.interest) ? datum.interest : datum.note",
      "as": "tooltip_value"
    }
  ],
  "facet": {
    "field": "creator",
    "type": "nominal",
    "title": null,
    "header": {
      "labelOrient": "top"
    },
    "sort": [
      "How Ridiculous",
      "LazarBeam",
      "Lachlan",
      "Bridey Drake"
    ]
  },
  "columns": 4,
  "spacing": {
    "row": 20,
    "column": 22
  },
  "spec": {
    "width": 190,
    "height": 190,
    "layer": [
      {
        "description": "Base layer: every tile in light grey, so states with too little search volume still show.",
        "mark": {
          "type": "rect",
          "cornerRadius": 3,
          "strokeWidth": 3,
          "fill": "#ececec",
          "cursor": "pointer",
          "stroke": "#ffffff"
        },
        "encoding": {
          "tooltip": [
            {
              "field": "creator",
              "title": "Creator"
            },
            {
              "field": "state",
              "title": "State or territory"
            },
            {
              "field": "tooltip_value",
              "title": "Share of the state's searches (100 = highest state)"
            }
          ]
        },
        "params": [
          {
            "name": "hover_state",
            "select": {
              "type": "point",
              "fields": [
                "state"
              ],
              "on": "pointerover",
              "clear": "pointerout"
            }
          }
        ]
      },
      {
        "mark": {
          "type": "rect",
          "cornerRadius": 3,
          "strokeWidth": 3,
          "cursor": "pointer",
          "stroke": "#ffffff"
        },
        "encoding": {
          "color": {
            "field": "interest",
            "type": "quantitative",
            "title": "Share of the state's YouTube searches (100 = highest state)",
            "scale": {
              "domain": [
                0,
                100
              ],
              "range": [
                "#fee0d2",
                "#a50f15"
              ]
            },
            "legend": {
              "orient": "bottom",
              "direction": "horizontal",
              "gradientLength": 220,
              "titleLimit": 320
            }
          },
          "tooltip": [
            {
              "field": "creator",
              "title": "Creator"
            },
            {
              "field": "state",
              "title": "State or territory"
            },
            {
              "field": "tooltip_value",
              "title": "Share of the state's searches (100 = highest state)"
            }
          ]
        },
        "transform": [
          {
            "filter": "isValid(datum.interest)"
          }
        ]
      },
      {
        "mark": {
          "type": "text",
          "fontWeight": "bold"
        },
        "encoding": {
          "text": {
            "field": "abbr"
          },
          "color": {
            "condition": [
              {
                "test": "!isValid(datum.interest)",
                "value": "#909090"
              },
              {
                "test": "datum.interest >= 55",
                "value": "#ffffff"
              }
            ],
            "value": "#0f0f0f"
          }
        }
      },
      {
        "description": "Hover highlight, drawn as its own top layer: a black outline round the hovered state in all four maps. (Drawn on the tiles themselves, the neighbouring tiles' white borders painted over it.)",
        "mark": {
          "type": "rect",
          "fillOpacity": 0,
          "stroke": "#0f0f0f",
          "strokeWidth": 3,
          "cornerRadius": 3
        },
        "transform": [
          {
            "filter": {
              "param": "hover_state",
              "empty": false
            }
          }
        ]
      }
    ],
    "encoding": {
      "x": {
        "field": "tile_x",
        "type": "ordinal",
        "axis": null,
        "scale": {
          "domain": [
            0,
            1,
            2,
            3
          ]
        }
      },
      "y": {
        "field": "tile_y",
        "type": "ordinal",
        "axis": null,
        "scale": {
          "domain": [
            0,
            1,
            2,
            3
          ]
        }
      }
    }
  },
  "title": {
    "text": "A darker square means a bigger share of that state's searching, not a bigger share of the creator's audience",
    "anchor": "start",
    "fontSize": 12,
    "fontWeight": "normal",
    "fontStyle": "italic",
    "color": "#606060",
    "offset": 14
  }
}