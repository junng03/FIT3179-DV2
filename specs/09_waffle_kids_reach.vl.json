{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Waffle chart (10 x 10): out of every 100 Australian children, how many watch YouTube. A switch shows all 6-13 year olds (89), ages 6-7 (84) or ages 8-13 (91). Source: Roy Morgan (2026), YouTube for Young Australians, Apr-Dec 2025, n = 1,129. Squares fill from the top-left with the children who watched YouTube, so the 'didn't watch' squares sit at the bottom.",
  "width": 300,
  "height": 300,
  "padding": {
    "top": 30
  },
  "params": [
    {
      "name": "age_pick",
      "value": "All 6-13",
      "bind": {
        "input": "radio",
        "options": [
          "All 6-13",
          "6-7",
          "8-13"
        ],
        "labels": [
          "All ages 6–13",
          "Ages 6–7",
          "Ages 8–13"
        ],
        "name": "Age group: "
      }
    }
  ],
  "data": {
    "url": "data/kids_youtube_reach.csv",
    "format": {
      "type": "csv",
      "parse": {
        "order": "number",
        "pct": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.age_group === age_pick"
    },
    {
      "calculate": "datum.group === 'Watch YouTube' ? 'Watched YouTube' : \"Didn't watch YouTube\"",
      "as": "group_label"
    },
    {
      "calculate": "sequence(0, datum.pct)",
      "as": "unit"
    },
    {
      "flatten": [
        "unit"
      ]
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "i"
        }
      ],
      "sort": [
        {
          "field": "order",
          "order": "ascending"
        },
        {
          "field": "unit",
          "order": "ascending"
        }
      ]
    },
    {
      "calculate": "(datum.i - 1) % 10",
      "as": "col"
    },
    {
      "calculate": "floor((datum.i - 1) / 10)",
      "as": "row"
    },
    {
      "calculate": "datum.pct + ' of every 100 children ' + (age_pick === 'All 6-13' ? 'aged 6–13' : age_pick === '6-7' ? 'aged 6–7' : 'aged 8–13')",
      "as": "headline"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "square",
        "size": 520,
        "opacity": 1,
        "cornerRadius": 2
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal",
          "axis": null
        },
        "y": {
          "field": "row",
          "type": "ordinal",
          "axis": null
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "title": null,
          "sort": [
            "Watch YouTube",
            "Don't watch YouTube"
          ],
          "scale": {
            "domain": [
              "Watch YouTube",
              "Don't watch YouTube"
            ],
            "range": [
              "#2a78d6",
              "#aeada5"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "symbolType": "square",
            "labelExpr": "datum.label === 'Watch YouTube' ? 'Watched YouTube' : \"Didn't watch YouTube\""
          }
        },
        "tooltip": [
          {
            "field": "group_label",
            "title": "Children aged 6-13, April-December 2025"
          },
          {
            "field": "pct",
            "title": "Out of every 100"
          }
        ]
      }
    },
    {
      "description": "Headline above the grid, read from the data so it follows the switch.",
      "transform": [
        {
          "filter": "datum.group === 'Watch YouTube' && datum.unit === 0"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#0b0b0b"
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "value": -12
        },
        "text": {
          "field": "headline"
        }
      }
    }
  ]
}